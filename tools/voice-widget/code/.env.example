# Groq API key the relay uses (pushed to the Worker as the GROQ_API_KEY secret by
# `relay/deploy.sh secrets --yes`). Turn on Zero Data Retention in the Groq console.
GROQ_API_KEY_PROD=
# Random string for the relay's /admin endpoints (pushed as the ADMIN_TOKEN secret;
# `tools/vw usage` reads it from here). Make one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
VW_ADMIN_TOKEN=
